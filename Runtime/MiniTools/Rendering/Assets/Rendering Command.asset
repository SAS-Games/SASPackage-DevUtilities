%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4b9c879de72c4503bd6de608ca62713a, type: 3}
  m_Name: Rendering Command
  m_EditorClassIdentifier:
  m_CommandName: Rendering
  m_Presets: []
  <CloseOnCompletion>k__BackingField: 1
  m_SubCommands:
  - Name: Status
    HelpText: Rendering.Status - Logs the active pipeline, quality, display, camera, and Rendering Debugger state.
    Presets: [Status]
    MethodName: Status
  - Name: Debugger
    HelpText: Rendering.Debugger <On|Off> - Shows or hides Unity's runtime Rendering Debugger.
    Presets: [Debugger On, Debugger Off]
    MethodName: Debugger
  - Name: Reset
    HelpText: Rendering.Reset - Restores captured Rendering Debugger and renderer-feature state.
    Presets: [Reset]
    MethodName: Reset
  - Name: Features
    HelpText: Rendering.Features - Lists active URP renderer features.
    Presets: [Features]
    MethodName: Features
  - Name: Feature
    HelpText: Rendering.Feature <feature-name> <On|Off>
    Presets: []
    MethodName: Feature
  - Name: RestoreFeatures
    HelpText: Rendering.RestoreFeatures - Restores renderer-feature states captured by Rendering.Feature.
    Presets: [RestoreFeatures]
    MethodName: RestoreFeatures
  - Name: Textures
    HelpText: Rendering.Textures [top-count] - Lists loaded textures by runtime memory.
    Presets: [Textures, Textures 10, Textures 25]
    MethodName: Textures
  - Name: RenderTargets
    HelpText: Rendering.RenderTargets [top-count] - Lists loaded render textures by runtime memory.
    Presets: [RenderTargets, RenderTargets 10]
    MethodName: RenderTargets
  - Name: Materials
    HelpText: Rendering.Materials [top-count] - Lists loaded materials by runtime memory.
    Presets: [Materials, Materials 10, Materials 25]
    MethodName: Materials
  - Name: Shaders
    HelpText: Rendering.Shaders - Summarizes loaded shaders and material usage.
    Presets: [Shaders]
    MethodName: Shaders
  m_HelpText: Runtime rendering diagnostics, debugger, renderer features, and resource reports.
