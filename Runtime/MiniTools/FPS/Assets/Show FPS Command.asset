%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ef4217f25f9996c4c8b4ac6705fa1300, type: 3}
  m_Name: Show FPS Command
  m_EditorClassIdentifier: 
  m_CommandName: Stats
  m_Presets: []
  <CloseOnCompletion>k__BackingField: 1
  m_SubCommands:
  - Name: FPS
    HelpText: 'Usage: Stats.FPS <On|Off> [anchor] [horizontal-padding] [vertical-padding]
      \nShows or hides the FPS overlay. Position and padding are optional. \nExamples:
      \n- Stats.FPS On \n- Stats.FPS On topright 20 50 \nAnchors: topleft,
      topcenter, topright, middleleft, middlecenter, middleright, bottomleft,
      bottomcenter, bottomright. \nPadding values must be integers.'
    Presets:
    - FPS On
    - FPS Off
    MethodName: ShowFPS
  - Name: Unit
    HelpText: 'Usage: Stats.Unit <On|Off> [anchor] [horizontal-padding] [vertical-padding]
      \nUnity equivalent of Unreal stat unit. Shows FPS, frame time, main/render thread,
      present wait, GPU time, VSync, target FPS, and memory.\n Example: Stats.Unit
      On topright 20 50'
    Presets:
    - Unit On
    - Unit Off
    MethodName: ShowFPS
  - Name: Rendering
    HelpText: 'Usage: Stats.Rendering <On|Off> [anchor] [horizontal-padding] [vertical-padding]
      \nShows live Batches, SetPass Calls, Draw Calls, Triangles, Vertices, Shadow
      Casters, render-texture count/memory, CPU/GPU frame timing, FPS, and memory.'
    Presets:
    - Rendering On
    - Rendering Off
    MethodName: ShowFPS
  - Name: Memory
    HelpText: 'Usage: Stats.Memory\n Unity equivalent of Unreal stat memory. Logs
      managed, Mono, native allocation, system RAM, graphics memory, and GC counters.'
    Presets:
    - Memory
    MethodName: Memory
  - Name: SceneRendering
    HelpText: 'Usage: Stats.SceneRendering\n Unity equivalent of Unreal stat scenerendering.
      Logs a CPU-side census of renderers, materials, mesh geometry, lights, cameras,
      LOD groups, and particle systems.'
    Presets:
    - SceneRendering
    MethodName: SceneRendering
  - Name: Levels
    HelpText: 'Usage: Stats.Levels\n Unity equivalent of Unreal stat levels. Logs
      every loaded scene, build index, root count, and active-scene state.'
    Presets:
    - Levels
    MethodName: Levels
  - Name: SetTargetFrameRate
    HelpText: 'Usage: Stats.SetTargetFrameRate <-1|fps> \nSets Unity''s target
      frame rate. FPS must be positive. -1 resets Unity''s target-frame-rate
      override; VSync remains disabled. \nExamples: \n- Stats.SetTargetFrameRate
      -1 \n- Stats.SetTargetFrameRate 60 \n- Stats.SetTargetFrameRate 120'
    Presets:
    - SetTargetFrameRate -1
    - SetTargetFrameRate 30
    - SetTargetFrameRate 60
    - SetTargetFrameRate 120
    MethodName: SetTargetFrameRate
  m_FpsPrefab: {fileID: 4840794096766531456, guid: fb3a402e3759cbe45813e6578e8d33e5, type: 3}
