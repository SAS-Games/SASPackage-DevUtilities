%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 47f8854bb6c20334a97ce2c514f766ef, type: 3}
  m_Name: Show FPS Command PS
  m_EditorClassIdentifier: 
  m_CommandName: Stats
  m_Presets: []
  <CloseOnCompletion>k__BackingField: 1
  m_SubCommands:
  - Name: FPS
    HelpText: 'Usage: Stats.FPS <On|Off> [anchor] [horizontal-padding] [vertical-padding]
      \nShows or hides the FPS overlay. Position and padding are optional. \nExamples:
      \n- Stats.FPS On \n- Stats.FPS On topright 20 50 \nAnchors: topleft,
      topcenter, topright, middleleft, middlecenter, middleright, bottomleft,
      bottomcenter, bottomright. \nPadding values must be integers.'
    Presets:
    - FPS On
    - FPS Off
    MethodName: ShowFPS
  - Name: SetTargetFrameRate
    HelpText: 'Usage: Stats.SetTargetFrameRate <-1|fps> \nSets the target frame
      rate. FPS must be positive. -1 resets the target-frame-rate override.
      PlayStation VSync is configured for exact 30 or 60 FPS targets and disabled
      for all other values. \nExamples: \n- Stats.SetTargetFrameRate -1 \n- Stats.SetTargetFrameRate
      30 \n- Stats.SetTargetFrameRate 60 \n- Stats.SetTargetFrameRate 120'
    Presets:
    - SetTargetFrameRate -1
    - SetTargetFrameRate 30
    - SetTargetFrameRate 60
    - SetTargetFrameRate 120
    MethodName: SetTargetFrameRate
  m_FpsPrefab: {fileID: 4840794096766531456, guid: fb3a402e3759cbe45813e6578e8d33e5, type: 3}
