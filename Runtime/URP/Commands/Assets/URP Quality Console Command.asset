%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9c7fc693a0953ad4ba429a6296949950, type: 3}
  m_Name: URP Quality Console Command
  m_EditorClassIdentifier:
  m_CommandName: Quality
  m_Presets: []
  <CloseOnCompletion>k__BackingField: 1
  m_SubCommands:
  - Name: Status
    HelpText: Quality.Status - Logs the active URP quality state.
    Presets: [Status]
    MethodName: Status
  - Name: Restore
    HelpText: Quality.Restore - Restores settings captured before the first runtime change.
    Presets: [Restore]
    MethodName: Restore
  - Name: SetUpscalingFilter
    HelpText: Quality.SetUpscalingFilter <Automatic|Linear|Point|FSR|STP>
    Presets: [SetUpscalingFilter Automatic, SetUpscalingFilter Linear, SetUpscalingFilter FSR, SetUpscalingFilter STP]
    MethodName: SetUpscalingFilter
  - Name: SetRenderScale
    HelpText: Quality.SetRenderScale <0.1-2.0>
    Presets: [SetRenderScale 0.5, SetRenderScale 0.75, SetRenderScale 1]
    MethodName: SetRenderScale
  - Name: SetMSAA
    HelpText: Quality.SetMSAA <0|1|2|4|8> - 0 and 1 both disable MSAA.
    Presets: [SetMSAA 0, SetMSAA 2, SetMSAA 4, SetMSAA 8]
    MethodName: SetMSAA
  - Name: SetHDR
    HelpText: Quality.SetHDR <On|Off>
    Presets: [SetHDR On, SetHDR Off]
    MethodName: SetHDR
  - Name: LODBias
    HelpText: Quality.LODBias <positive-value>
    Presets: [LODBias 0.5, LODBias 1, LODBias 2]
    MethodName: SetLOD
  - Name: VSync
    HelpText: Quality.VSync <0-4>
    Presets: [VSync 0, VSync 1, VSync 2]
    MethodName: SetVSync
  - Name: TextureQuality
    HelpText: Quality.TextureQuality <0-3> - 0 is full resolution; 3 is eighth resolution.
    Presets: [TextureQuality 0, TextureQuality 1, TextureQuality 2, TextureQuality 3]
    MethodName: SetTextureQuality
  m_HelpText: Inspect, modify, and restore active URP quality settings.
