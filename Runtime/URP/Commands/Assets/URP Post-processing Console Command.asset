%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9c7fc693a0953ad4ba429a6296949950, type: 3}
  m_Name: URP Post-processing Console Command
  m_EditorClassIdentifier:
  m_CommandName: PP
  m_Presets: []
  <CloseOnCompletion>k__BackingField: 1
  m_SubCommands:
  - Name: Status
    HelpText: PP.Status - Logs camera and Volume post-processing state.
    Presets: [Status]
    MethodName: Status
  - Name: Restore
    HelpText: PP.Restore - Restores captured post-processing settings.
    Presets: [Restore]
    MethodName: Restore
  - Name: SetEnabled
    HelpText: PP.SetEnabled <On|Off> [all|camera-name]
    Presets: [SetEnabled On all, SetEnabled Off all]
    MethodName: SetPostProcessingEnabled
  - Name: VolumeList
    HelpText: PP.VolumeList - Lists loaded Volumes and their weights.
    Presets: [VolumeList]
    MethodName: VolumeList
  - Name: SetVolumeWeight
    HelpText: PP.SetVolumeWeight <volume-name> <0-1>
    Presets: []
    MethodName: SetVolumeWeight
  - Name: SetColorGradingMode
    HelpText: PP.SetColorGradingMode <LowDynamicRange|HighDynamicRange>
    Presets: [SetColorGradingMode LowDynamicRange, SetColorGradingMode HighDynamicRange]
    MethodName: SetColorGradingMode
  - Name: SetLUTSize
    HelpText: PP.SetLUTSize <16-65>
    Presets: [SetLUTSize 16, SetLUTSize 32, SetLUTSize 64]
    MethodName: SetLUTSize
  m_HelpText: Inspect, modify, and restore URP post-processing settings.
