%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e329f9243e9df4c409d8fd44485114bb, type: 3}
  m_Name: HDRP Quality Command
  m_EditorClassIdentifier:
  m_CommandName: Quality
  m_Presets: []
  <CloseOnCompletion>k__BackingField: 1
  m_SubCommands:
  - Name: Status
    HelpText: Quality.Status - Logs active HDRP dynamic-resolution quality state.
    Presets: [Status]
    MethodName: Status
  - Name: Restore
    HelpText: Quality.Restore - Restores HDRP and camera settings captured before the first change.
    Presets: [Restore]
    MethodName: Restore
  - Name: SetUpscalingFilter
    HelpText: 'Quality.SetUpscalingFilter <CatmullRom|ContrastAdaptiveSharpen|EdgeAdaptiveScalingUpres|TAAU> [all|camera-name]'
    Presets:
    - 'SetUpscalingFilter CatmullRom '
    - 'SetUpscalingFilter ContrastAdaptiveSharpen '
    - 'SetUpscalingFilter EdgeAdaptiveScalingUpres '
    - 'SetUpscalingFilter TAAU '
    MethodName: SetUpscalingFilter
  - Name: SetScreenPercentage
    HelpText: 'Quality.SetScreenPercentage <percent> \nSets the internal screen percentage
      by clamping between minimum & maximum percentage  set on dyanmic resolution
      settings (0 to 100).\n Lower values improve performance, higher values improve
      quality.\nExample: Quality.SetScreenPercentage 50'
    Presets:
    - SetScreenPercentage 1
    - SetScreenPercentage 25
    - SetScreenPercentage 50
    - SetScreenPercentage 75
    - SetScreenPercentage 100
    MethodName: SetScreenPercentage
  m_HelpText: Commands for inspecting, modifying, and restoring HDRP quality settings at runtime.
